# ====================================================================
# XCloud Flow — Environment Variables
# Copy this file to ".env.local" and fill in the values you need.
# ====================================================================

# ===== Supabase (推奨・本番では必須) =====
# 未設定でもアプリは起動しますが、データ取得・認証はできません。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== Stripe (任意) =====
# 未設定なら自動でデモ決済 (demo_paid) にフォールバックします。
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== LINE Webhook 通知 (任意) =====
# 管理画面の「設定」から DB に保存することも可能 (DBが優先)。
# 未設定なら通知は "skipped" としてログに残ります。
# LINE_WEBHOOK_URL=https://example.com/your-line-webhook

# ===== サイトURL (Vercelデプロイ後に設定推奨) =====
# OGP / 内部リンク生成に使用。
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
