# ====================================================================
# XCloud-Flow — Environment Variables
# Copy this file to ".env.local" and fill in the values.
# Vercel: paste the same keys in Project Settings → Environment Variables.
# ====================================================================

# ===== 必須 =====
NEXT_PUBLIC_SUPABASE_URL=https://jzktegqjepzvusijhrhzd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://xcloud-flow.vercel.app

# ===== 推奨 (本番販売時) =====
# Stripe Checkout / Subscription / Customer Portal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Resend で実メール送信 (招待 / 予約確認 / 問い合わせ自動応答)
RESEND_API_KEY=
RESEND_FROM=XCloud-Flow <noreply@xcloud-flow.app>

# 運営者情報 (特定商取引法に基づく表記 / フッター / メール署名で使用)
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===== 任意 =====
# LINE Webhook 通知
LINE_WEBHOOK_URL=

# OpenAI (未設定なら /api/ai/* はルールベースのフォールバックで動作)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Service Role Key (運用バッチ等)
SUPABASE_SERVICE_ROLE_KEY=
