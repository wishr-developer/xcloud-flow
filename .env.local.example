# ====================================================================
# XCloud-Flow — Environment Variables
# Copy this file to ".env.local" and fill in the values.
# Vercel: paste the same keys in Project Settings → Environment Variables.
# ====================================================================

# ===== 必須 =====
NEXT_PUBLIC_SUPABASE_URL=https://jzktegqjepzvusijhrhzd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# ===== 任意 =====
# Stripe Checkout / Subscription (未設定なら自動でデモ決済 demo_paid)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# サブスク用の Stripe Price ID (未設定ならデモ動作)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# LINE Webhook 通知 (未設定なら通知は "skipped" としてログ)
LINE_WEBHOOK_URL=

# OpenAI (未設定なら /api/ai/* はルールベースのフォールバックで動作)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Service Role Key (Stripe webhook 等で RLS バイパスする時)
SUPABASE_SERVICE_ROLE_KEY=
